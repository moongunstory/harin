{
  "rules": {
    ".read": false,
    ".write": false,
    "GlobalStats": {
      ".read": true,
      "$axis": {
        "$type": {
          ".write": "auth != null && newData.isNumber() && (!data.exists() || newData.val() >= data.val())"
        }
      }
    },
    "Nicknames": {
      ".read": true,
      "$nickname_lower": {
        ".write": "auth != null",
        ".validate": "newData.isString()"
      }
    },
    "Users": {
      ".read": true,
      "$uid": {
        ".read": true,
        ".write": "auth != null",
        "nickname": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9A-Za-z._\\-가-힣 ]{2,20}$/)"
        },
        "mbti_type": {
          ".validate": "newData.isString() && newData.val().matches(/^(|ENFJ|ENFP|ENTJ|ENTP|ESFJ|ESFP|ESTJ|ESTP|INFJ|INFP|INTJ|INTP|ISFJ|ISFP|ISTJ|ISTP)$/)"
        },
        "bio": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "equipped_title": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "total_clicks": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "clicks": {
          "$type": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        },
        "$other": {
          ".validate": true
        }
      }
    },
    "GlobalChat": {
      ".read": true,
      "$msgId": {
        ".write": "auth != null",
        "userId": {
          ".validate": "newData.isString()"
        },
        "nickname": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9A-Za-z._\\-가-힣 ]{2,20}$/)"
        },
        "mbtiType": {
          ".validate": "newData.isString() && newData.val().matches(/^(|ENFJ|ENFP|ENTJ|ENTP|ESFJ|ESFP|ESTJ|ESTP|INFJ|INFP|INTJ|INTP|ISFJ|ISFP|ISTJ|ISTP)$/)"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "timestamp": {
          ".validate": "newData.isNumber() || newData.val() == now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "MatchQueue": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['nickname','timestamp']) || !newData.exists()"
      }
    },
    "UserStatus": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "PrivateRooms": {
      "$roomId": {
        ".read": "auth != null",
        "info": {
          ".write": "auth != null"
        },
        "messages": {
          "$msgId": {
            ".write": "auth != null",
            "userId": {
              ".validate": "newData.isString()"
            },
            "nickname": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9A-Za-z._\\-가-힣 ]{2,20}$/)"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
            },
            "timestamp": {
              ".validate": "newData.isNumber() || newData.val() == now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "makgoraStats": {
      ".read": true,
      "$uid": {
        ".write": "auth != null"
      }
    },
    "makgoraHistory": {
      ".read": true,
      "$uid": {
        ".write": "auth != null"
      }
    },
    "HeadToHead": {
      ".read": true,
      "$uid": {
        ".write": "auth != null"
      }
    },
    "MakgoraInvites": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "MakgoraInviteResponse": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "MakgoraRooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "MakgoraQueue": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null"
      }
    },
    "events": {
      "superchat": {
        ".read": true,
        ".write": false
      }
    },
    "donations": {
      "auth": {
        "$txid": {
          ".read": false,
          ".write": false
        }
      }
    }
  }
}
